@model SlivEliteEvents.Models.Event
@{
ViewData["Title"] = "Уреди настан";
string endTimeValue = Model.EndTime.HasValue ? Model.EndTime.Value.ToString("yyyy-MM-dd") : "";
string startTimeTime = Model.StartTime != default ? Model.StartTime.ToString("HH:mm") : "";
string endTimeTime = Model.EndTime.HasValue ? Model.EndTime.Value.ToString("HH:mm") : "";
}
<h1>Уреди настан</h1>
@if (!ViewData.ModelState.IsValid)
{
<div class="alert alert-danger">
    <ul>
        @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
        {
        <li>@error.ErrorMessage</li>
        }
    </ul>
</div>
}
<form id="editForm" asp-action="Edit" method="post">
    <input type="hidden" asp-for="Id" />
    <div class="mb-3">
        <label asp-for="Title" class="form-label required">Наслов</label>
        <input asp-for="Title" class="form-control" />
        <span asp-validation-for="Title" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Description" class="form-label">Опис</label>
        <textarea asp-for="Description" class="form-control" rows="4"></textarea>
        <span asp-validation-for="Description" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="StartTime" class="form-label required">Почнува</label>
        <div class="row">
            <div class="col-md-6">
                <input type="date" asp-for="StartTime" class="form-control" value="@Model.StartTime.ToString("yyyy-MM-dd")" />
                <span asp-validation-for="StartTime" class="text-danger"></span>
            </div>
            <div class="col-md-6" id="startTimeContainer">
                <input type="time" id="StartTimeTime" name="StartTimeTime" class="form-control" value="@startTimeTime" />
                <span class="text-danger field-validation-error" data-valmsg-for="StartTimeTime"></span>
            </div>
        </div>
    </div>
    <div class="mb-3" id="endTimeContainer">
        <label asp-for="EndTime" class="form-label">Завршува</label>
        <div class="row">
            <div class="col-md-6">
                <input type="date" asp-for="EndTime" class="form-control" value="@endTimeValue" />
                <span asp-validation-for="EndTime" class="text-danger"></span>
            </div>
            <div class="col-md-6">
                <input type="time" id="EndTimeTime" name="EndTimeTime" class="form-control" value="@endTimeTime" />
                <span class="text-danger field-validation-error" data-valmsg-for="EndTimeTime"></span>
            </div>
        </div>
    </div>
    <div class="mb-3">
        <label asp-for="IsAllDay" class="form-label">Целодневен</label>
        <input asp-for="IsAllDay" type="checkbox" class="form-check-input" />
        <span asp-validation-for="IsAllDay" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Location" class="form-label required">Локација</label>
        <input asp-for="Location" class="form-control" />
        <span asp-validation-for="Location" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="GuestCapacity" class="form-label required">Капацитет на гости</label>
        <input asp-for="GuestCapacity" class="form-control" type="number" />
        <span asp-validation-for="GuestCapacity" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ContactPhone" class="form-label">Контакт телефон</label>
        <input asp-for="ContactPhone" class="form-control" />
        <span asp-validation-for="ContactPhone" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Status" class="form-label required">Статус</label>
        <select asp-for="Status" class="form-control">
            <option value="Pending" selected="@(Model.Status == "Pending")">Во исчекување</option>
            <option value="Confirmed" selected="@(Model.Status == "Confirmed")">Потврдено</option>
            <option value="Completed" selected="@(Model.Status == "Completed")">Завршено</option>
        </select>
        <span asp-validation-for="Status" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Зачувај промени</button>
    <a asp-action="Index" class="btn btn-secondary">Назад до календар</a>
</form>

@section Scripts {
<partial name="_ValidationScriptsPartial" />
<script>
    $(function () {
        const startTimeContainer = $('#startTimeContainer');
        const endTimeContainer = $('#endTimeContainer');
        const isAllDayCheckbox = $('#IsAllDay');

        
        if (isAllDayCheckbox.is(':checked')) {
            startTimeContainer.hide();
            endTimeContainer.hide();
            $('#EndTime').val('');
            $('#StartTimeTime').val('');
            $('#EndTimeTime').val('');
        }

        
        isAllDayCheckbox.change(function () {
            if ($(this).is(':checked')) {
                startTimeContainer.hide();
                endTimeContainer.hide();
                $('#EndTime').val('');
                $('#StartTimeTime').val('');
                $('#EndTimeTime').val('');
            } else {
                startTimeContainer.show();
                endTimeContainer.show();
            }
        });

        
        $.validator.addMethod("endTimeAfterStart", function (value, element) {
            if ($('#IsAllDay').is(':checked')) return true;
            var startDate = $('#StartTime').val();
            var startTime = $('#StartTimeTime').val();
            var endDate = $('#EndTime').val();
            var endTime = value;
            if (!startDate || !startTime || !endDate || !endTime) return true;
            var startDateTime = new Date(startDate + 'T' + startTime);
            var endDateTime = new Date(endDate + 'T' + endTime);
            return endDateTime > startDateTime;
        }, "Крајното време мора да биде после почетното време.");

        $.validator.addMethod("requiredIfNotAllDay", function (value, element) {
            return $('#IsAllDay').is(':checked') || !!(value && value.trim());
        }, "Ова поле е задолжително за нецелодневни настани.");

        $("#editForm").validate({
            rules: {
                StartTimeTime: { requiredIfNotAllDay: true },
                EndTimeTime: { requiredIfNotAllDay: true, endTimeAfterStart: true }
            },
            errorPlacement: function (error, element) {
                error.appendTo(element.closest('.col-md-6').find('.field-validation-error'));
            }
        });
    });
</script>
}