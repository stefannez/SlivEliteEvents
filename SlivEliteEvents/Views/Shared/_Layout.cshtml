<!DOCTYPE html>
<html lang="mk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sliv Elite Events</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.0/main.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" asp-controller="Home" asp-action="Index">Sliv Elite Events</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" 
                    aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Index">Календар</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="List">Листа настани</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Events" asp-action="Create">Креирај Настан</a>
                        </li>
                    }
                </ul>
                <div class="ms-2">
                    @if (User.Identity.IsAuthenticated)
                    {
                        <span class="navbar-text me-2 text-white">Здраво, @User.Identity.Name</span>
                        <a class="btn btn-outline-light btn-sm" asp-controller="Account" asp-action="Logout">Одјави се</a>
                    }
                    else
                    {
                        <a class="btn btn-outline-primary btn-sm" asp-controller="Account" asp-action="Login">Најави се</a>
                    }
                    <button id="themeToggle" class="btn btn-outline-light btn-sm ms-2" aria-label="Промени тема">
                        <img id="themeIcon" src="https://i.postimg.cc/Cx1Vrg96/moon-4-512.png" height="30" width="30" alt="Темна тема" />
                    </button>
                </div>
            </div>
        </div>
    </nav>
</header>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2025 - Sliv Elite Events
    </div>
</footer>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.0/main.min.js"></script>
<script>
    $(document).ready(function () {
        // Theme toggle functionality
        $('#themeToggle').click(function () {
            $('body').toggleClass('dark-mode');
            var isDarkMode = $('body').hasClass('dark-mode');
            $('#themeIcon').attr('src', isDarkMode ? 
                'https://i.postimg.cc/Cx1Vrg96/moon-4-512.png' : 
                'https://i.postimg.cc/Cx1Vrg96/moon-4-512.png');
            $('#themeIcon').attr('alt', isDarkMode ? 'Светла тема' : 'Темна тема');
            localStorage.setItem('theme', isDarkMode ? 'dark' : 'light');
        });

        // Apply saved theme on page load
        if (localStorage.getItem('theme') === 'dark') {
            $('body').addClass('dark-mode');
            $('#themeIcon').attr('src', 'https://i.postimg.cc/Cx1Vrg96/moon-4-512.png');
            $('#themeIcon').attr('alt', 'Светла тема');
        }
    });
</script>
<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>